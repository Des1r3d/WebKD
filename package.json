{
  "name": "synchub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm run setup:env && npm ci --prefix server && npm run prisma:generate && npm run prisma:deploy",
    "setup:env": "node -e \"const fs=require('fs');if(!fs.existsSync('server/.env'))fs.copyFileSync('server/.env.example','server/.env')\"",
    "seed": "npm run prisma:seed --prefix server",
    "dev": "npm run dev --prefix server",
    "test": "npm run test --prefix server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:deploy": "npm run prisma:deploy --prefix server",
    "start": "npm run start --prefix server"
  }
}
