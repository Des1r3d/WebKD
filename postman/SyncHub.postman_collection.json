{
  "info": {
    "_postman_id": "a9d82f10-3e4a-4c11-98ab-synchub2026",
    "name": "SyncHub API Collection (BookSlot + GroupOrder)",
    "description": "Bộ kiểm thử API tự động & hộp đen cho đồ án SyncHub (12 bảng, 15 Business Rules, 12 Use Cases).\n\nHướng dẫn chạy:\n1. Khởi động server: `npm run dev:server` (chạy tại `http://localhost:5000`).\n2. Biến môi trường mặc định: `baseUrl = http://localhost:5000`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "hostToken",
      "value": "jwt_host_usr-host-01",
      "type": "string"
    },
    {
      "key": "memberBToken",
      "value": "jwt_member_usr-mem-02",
      "type": "string"
    },
    {
      "key": "memberCToken",
      "value": "jwt_member_usr-mem-03",
      "type": "string"
    },
    {
      "key": "flaggedToken",
      "value": "jwt_member_usr-flag-05",
      "type": "string"
    },
    {
      "key": "providerToken",
      "value": "jwt_provider_usr-prv-01",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "jwt_admin_usr-adm-01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth & Reputation (UC01 · BR-REP-01)",
      "item": [
        {
          "name": "POST /api/auth/login (Host Hạng A)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dat.dt@synchub.vn\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "GET /api/auth/me (Kiểm tra điểm & hạng uy tín)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Providers & Search Map (UC02)",
      "item": [
        {
          "name": "GET /api/providers (Lọc bán kính <= 1km quanh Làng ĐH)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/providers?lat=10.8752&lng=106.8007&radius=1000"
          }
        },
        {
          "name": "GET /api/providers/prv-venue-01 (Chi tiết sân & danh sách slots)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/providers/prv-venue-01"
          }
        }
      ]
    },
    {
      "name": "3. Slot Locking & Concurrency (UC03 · BR-SLT-01/02)",
      "item": [
        {
          "name": "POST /api/slots/slt-01/lock (Khóa slot nguyên tử 10 phút)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/slots/slt-01/lock"
          }
        },
        {
          "name": "POST /api/slots/slt-01/release (Nhả slot về AVAILABLE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/slots/slt-01/release"
          }
        }
      ]
    },
    {
      "name": "4. Group Lobby & Reputation Deposit (UC04, UC05 · BR-INT-01, BR-REP-01)",
      "item": [
        {
          "name": "GET /api/lobbies/SYNC01 (Chi tiết phòng ghép kèo)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/lobbies/SYNC01"
          }
        },
        {
          "name": "POST /api/lobbies/SYNC01/join (Member Hạng B -> Cọc 30%)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberBToken}}" }],
            "url": "{{baseUrl}}/api/lobbies/SYNC01/join"
          }
        },
        {
          "name": "POST /api/lobbies/SYNC01/join (User FLAGGED <50đ -> 403 Chặn)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{flaggedToken}}" }],
            "url": "{{baseUrl}}/api/lobbies/SYNC01/join"
          }
        }
      ]
    },
    {
      "name": "5. Smart Recommend, Voucher & Split Bill (UC07, UC08 · BR-INT-02, BR-INT-04, BR-INT-05)",
      "item": [
        {
          "name": "GET /api/recommend?lobbyId=SYNC01 (Gợi ý quán F&B <= 1km)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/recommend?lobbyId=SYNC01"
          }
        },
        {
          "name": "POST /api/vouchers/validate (Kiểm tra mã CROSS <= 1000m)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hostToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CROSSLANGDH15\",\n  \"lobbyId\": \"SYNC01\"\n}"
            },
            "url": "{{baseUrl}}/api/vouchers/validate"
          }
        },
        {
          "name": "POST /api/lobbies/SYNC01/lock (Khóa giỏ hàng tức thì BR-INT-04)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/lobbies/SYNC01/lock"
          }
        },
        {
          "name": "POST /api/lobbies/SYNC01/split (Chia bill Largest Remainder & sinh VietQR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/lobbies/SYNC01/split"
          }
        }
      ]
    },
    {
      "name": "6. Escrow, Check-in & Idempotency (UC09, UC10 · BR-ESC-01/02/03, BR-REP-02/03)",
      "item": [
        {
          "name": "POST /api/payments/webhook-mock (Giả lập nhận tiền VietQR -> HOLD)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hostToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"splitBillId\": \"sb-01\"\n}"
            },
            "url": "{{baseUrl}}/api/payments/webhook-mock"
          }
        },
        {
          "name": "GET /api/escrow/lob-01 (Xem sổ cái giao dịch Escrow)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": "{{baseUrl}}/api/escrow/lob-01"
          }
        },
        {
          "name": "POST /api/lobbies/lob-01/checkin (Check-in & Giải ngân VENUE 8% / FNB 12%)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hostToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"members\": [\n    { \"userId\": \"usr-host-01\", \"status\": \"CHECKED_IN\" },\n    { \"userId\": \"usr-mem-02\", \"status\": \"CHECKED_IN\" },\n    { \"userId\": \"usr-mem-03\", \"status\": \"CHECKED_IN\" },\n    { \"userId\": \"usr-mem-04\", \"status\": \"CHECKED_IN\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/lobbies/lob-01/checkin"
          }
        }
      ]
    },
    {
      "name": "7. Disputes, Provider & Admin Governance (UC11, UC12 · BR-ESC-04, BR-DSP-01)",
      "item": [
        {
          "name": "POST /api/disputes (Tạo khiếu nại & đóng băng FROZEN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hostToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lobbyId\": \"lob-01\",\n  \"targetProviderId\": \"prv-fnb-01\",\n  \"reason\": \"Giao thiếu 1 ly Trà Sữa Trân Châu Hoàng Kim\",\n  \"refundAmount\": 30000\n}"
            },
            "url": "{{baseUrl}}/api/disputes"
          }
        },
        {
          "name": "PATCH /api/admin/disputes/dsp-01/resolve (Admin phân xử hoàn tiền & ghi Audit Log)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"refundAmount\": 30000\n}"
            },
            "url": "{{baseUrl}}/api/admin/disputes/dsp-01/resolve"
          }
        },
        {
          "name": "GET /api/admin/stats (Thống kê GMV, Hoa hồng, FLAGGED, Audit Logs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/stats"
          }
        }
      ]
    }
  ]
}
