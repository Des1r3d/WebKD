flowchart TD
  subgraph L_HOST["Lane 1: HOST (Trưởng nhóm)"]
    H1(["Bắt đầu: Tìm sân trên Map"]) --> H2["Chọn khung giờ & Giữ chỗ 10' (BR-SLT-01)"]
    H2 --> H3["Mở Phòng ghép kèo & Chia sẻ QR (BR-INT-01)"]
    H3 --> H4["Chọn Quán FNB gợi ý & Áp mã CROSS (BR-INT-05)"]
    H4 --> H5["Bấm Chốt phòng & Chia bill (BR-INT-04)"]
    H5 --> H6["Xác nhận Check-in tại sân"]
  end

  subgraph L_MEMBER["Lane 2: MEMBER (Thành viên)"]
    M1["Quét QR vào phòng"] --> M2{"Kiểm tra điểm uy tín (BR-REP-01)"}
    M2 -- "< 50 (FLAGGED)" --> M_ERR(["Chặn vào phòng (403)"])
    M2 -- ">= 50 (Hạng A/B/C)" --> M3["Đóng cọc (0% / 30% / 100%) & Vào phòng"]
    M3 --> M4["Chọn món nước vào Giỏ hàng chung Realtime"]
    M4 --> M5["Nhận Bill cá nhân & Quét VietQR thanh toán"]
  end

  subgraph L_SYS["Lane 3: Hệ thống SyncHub & Ví Escrow"]
    S1["Khóa Slot nguyên tử 10 phút (BR-SLT-02)"]
    S2["Đồng bộ Giỏ hàng & Khóa nút khi LOCKED"]
    S3["Chạy SplitBill (Largest Remainder) + Sinh VietQR (BR-INT-02)"]
    S4["Nhận Webhook -> Giữ tiền Escrow HOLD (BR-ESC-01)"]
    S5{"Có khiếu nại OPEN? (BR-ESC-04)"}
    S6["Đóng băng FROZEN -> Admin phân xử REFUND (BR-DSP-01)"]
    S7["Giải ngân đa bên + Cộng/Trừ điểm uy tín (BR-ESC-02/03)"]
  end

  subgraph L_PROV["Lane 4: PROVIDER (Chủ sân VENUE & Quán FNB)"]
    P1["VENUE nhận 92% tiền sân (trừ 8% hoa hồng)"]
    P2["FNB chuẩn bị đơn & nhận 88% tiền nước (trừ 12% hoa hồng)"]
    P_END(["Kết thúc phiên (COMPLETED)"])
  end

  H2 --> S1
  S1 --> H3
  H3 --> M1
  M4 <--> S2
  H4 --> S2
  H5 --> S3
  S3 --> M5
  M5 --> S4
  S4 --> H6
  H6 --> S5
  S5 -- "Có tranh chấp" --> S6
  S5 -- "Không tranh chấp" --> S7
  S6 --> P_END
  S7 --> P1
  S7 --> P2
  P1 --> P_END
  P2 --> P_END
