stateDiagram-v2
  direction TB

  state "Vòng đời Phòng ghép kèo (GroupLobby Lifecycle)" as LobbySM {
    [*] --> OPEN: Host tạo phòng từ Slot đã LOCKED (BR-INT-01)
    OPEN --> LOCKED: Host bấm Chốt đơn (BR-INT-04 - Khóa giỏ hàng)
    OPEN --> CANCELLED: Host hủy / Slot hết hạn 10 phút (BR-SLT-01)
    LOCKED --> AWAITING_PAYMENT: Chạy SplitBill + Sinh VietQR (BR-INT-02)
    AWAITING_PAYMENT --> PAID: 100% thành viên thanh toán (BR-ESC-01)
    AWAITING_PAYMENT --> CANCELLED: Quá hạn / Hủy liên đới -> Hoàn tiền HELD (BR-INT-03)
    PAID --> COMPLETED: Check-in thành công -> Giải ngân VENUE & FNB (BR-ESC-02)
    PAID --> DISPUTED: Thành viên gửi khiếu nại trước giải ngân (BR-ESC-04)
    DISPUTED --> COMPLETED: Admin phân xử REFUND / RELEASE (BR-DSP-01)
    COMPLETED --> [*]
    CANCELLED --> [*]
  }

  state "Vòng đời Giao dịch Ví trung gian (EscrowStatus Lifecycle)" as EscrowSM {
    [*] --> HELD: Webhook xác nhận VietQR (type=HOLD)
    HELD --> RELEASED: Check-in -> Tách tiền VENUE (-8%) & FNB (-12%) (idempotency_key)
    HELD --> REFUNDED: Hủy liên đới phòng / Slot (BR-INT-03)
    HELD --> FROZEN: Có khiếu nại OPEN nhắm vào Provider (BR-ESC-04)
    FROZEN --> REFUNDED: Admin chấp thuận hoàn tiền cho Member (BR-DSP-01)
    FROZEN --> RELEASED: Admin bác bỏ khiếu nại / Giải ngân phần dư
    RELEASED --> [*]
    REFUNDED --> [*]
  }
