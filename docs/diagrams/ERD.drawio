        <mxCell id="erd_legend_box" parent="1" vertex="1" value="&lt;b&gt;CHÚ GIẢI (LEGEND)&lt;/b&gt;: &lt;font color='#C53030'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt;=Khóa chính | &lt;font color='#2B6CB0'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;=Khóa ngoại | &lt;font color='#276749'&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/font&gt;=Duy nhất&lt;br/&gt;&lt;b&gt;BẢN SỐ&lt;/b&gt;: &lt;b&gt;||&lt;/b&gt;=Bắt buộc 1 | &lt;b&gt;o{&lt;/b&gt;=0..N | &lt;b&gt;|{&lt;/b&gt;=1..N | &lt;b&gt;o|&lt;/b&gt;=0..1&lt;br/&gt;Khóa duy nhất ghép: slots(provider_id, start_at) và split_bills(lobby_id, user_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;fontFamily=Helvetica, Arial, sans-serif;fontSize=10;align=center;fontColor=#1E293B;">
