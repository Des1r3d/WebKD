        <mxCell id="erd_header_banner" parent="1" vertex="1" value="&lt;b&gt;SYNCHUB (WEBKD) — SƠ ĐỒ CƠ SỞ DỮ LIỆU THỰC THỂ LIÊN KẾT (PHYSICAL ERD)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; font-weight: normal; color: #4A5568;'&gt;12 Bảng Thực thể Vật lý PostgreSQL &amp; Ký hiệu Chân quạ Martin's Crow's Foot Notation (100% Orthogonal Connectors)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Helvetica, Arial, sans-serif;fontSize=12;align=center;fontColor=#1E293B;">
